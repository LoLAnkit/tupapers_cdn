{
  "name": "tupapers-assets",
  "version": "1.0.0",
  "description": "R2 asset CDN pipeline for TUpapers — optimize, content-hash, upload to Cloudflare R2, emit manifest.json.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tupapers-assets": "src/index.ts"
  },
  "scripts": {
    "build": "tsx src/index.ts build",
    "upload": "tsx src/index.ts upload",
    "sync": "tsx src/index.ts sync",
    "tinify": "tsx src/minify-source.ts",
    "minify:source": "tsx src/minify-source.ts",
    "prune": "tsx src/index.ts prune",
    "scaffold:bca": "tsx scripts/scaffold-bca.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "p-limit": "^6.1.0",
    "sharp": "^0.33.5",
    "svgo": "^3.3.2",
    "tinify": "^1.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/node": "^22.7.4",
    "eslint": "^9.11.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0"
  }
}
