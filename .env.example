# Cloudflare R2 credentials — copy this file to `.env` and fill in real values.
# Never commit `.env`.

# From the R2 overview page (32-char hex).
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# From "Manage R2 API Tokens" → Object Read & Write, scoped to the `tupapers` bucket only.
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bucket name (already created in Cloudflare).
R2_BUCKET=tupapers

# S3-compatible endpoint. Leave as-is; ${R2_ACCOUNT_ID} is substituted automatically if omitted.
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

# Public custom domain connected to the bucket.
CDN_BASE=https://cdn.tupapers.com

# Optional: parallel Sharp processing/upload workers (default 6).
# CONCURRENCY=6
